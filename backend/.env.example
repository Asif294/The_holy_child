# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Core
DJANGO_ENV=development            # development | production
DEBUG=True
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — PostgreSQL
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=holychild
DATABASE_USER=holychild
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432          # check with `pg_lsclusters` — a second cluster often sits on 5433

# JWT
# defaults to SECRET_KEY when blank
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS / CSRF (the Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Locale
TIME_ZONE=Asia/Dhaka
LANGUAGE_CODE=en-us
LOG_LEVEL=INFO

# Bootstrap administrator — consumed by `manage.py seed_initial_data`
DJANGO_ADMIN_EMAIL=admin@holychildschool.edu.bd
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_NAME=System Administrator

# School identity — SEED VALUES ONLY.
# These populate the school profile the first time the database is read.
# After that the profile lives in the `school_profile` table and is edited
# from Settings -> School profile in the app; changing them here has no
# effect on an existing database.
SCHOOL_NAME_EN=The Holy Child Pre-Cadet & High School
SCHOOL_NAME_BN=দি হলি চাইল্ড প্রি-ক্যাডেট এন্ড হাই স্কুল
SCHOOL_SHORT_NAME=Holy Child
SCHOOL_VILLAGE=Longorpara
SCHOOL_UPAZILA=Sribordi
SCHOOL_DISTRICT=Sherpur
SCHOOL_COUNTRY=Bangladesh
SCHOOL_ESTABLISHED=2006
SCHOOL_GRADE_RANGE=Play Group to Class 10
SCHOOL_EMAIL=info@holychildschool.edu.bd
SCHOOL_PHONE=+880 1700-000000

# Email (production only)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

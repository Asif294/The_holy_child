# Core
DJANGO_ENV=production
DEBUG=False
# A DIFFERENT key from the development one.
SECRET_KEY=
DOMAIN=holychildschool.edu.bd
ALLOWED_HOSTS=holychildschool.edu.bd,www.holychildschool.edu.bd,backend

# HTTPS — nginx terminates TLS and forwards X-Forwarded-Proto.
# Keep False only while the stack is still serving plain HTTP.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Database — `db` is the service name on the compose network
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=the_holy
DATABASE_USER=holy_user
DATABASE_PASSWORD=
DATABASE_HOST=db
DATABASE_PORT=5432

# JWT — a different key again. Blank falls back to SECRET_KEY.
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS / CSRF — one origin serves both halves in production
CORS_ALLOWED_ORIGINS=https://holychildschool.edu.bd
CSRF_TRUSTED_ORIGINS=https://holychildschool.edu.bd

# Frontend — relative base path, nginx does the routing
VITE_API_BASE_URL=/api/v1

# Locale
TIME_ZONE=Asia/Dhaka
LANGUAGE_CODE=en-us
LOG_LEVEL=INFO

# Bootstrap administrator — change this password once you have signed in
DJANGO_ADMIN_EMAIL=admin@holychildschool.edu.bd
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_NAME=System Administrator

# School identity — seed values for a fresh database only
SCHOOL_NAME_EN=The Holy Child Pre-Cadet & High School
SCHOOL_NAME_BN=দি হলি চাইল্ড প্রি-ক্যাডেট এন্ড হাই স্কুল
SCHOOL_SHORT_NAME=Holy Child
SCHOOL_VILLAGE=Longorpara
SCHOOL_UPAZILA=Sribordi
SCHOOL_DISTRICT=Sherpur
SCHOOL_COUNTRY=Bangladesh
SCHOOL_ESTABLISHED=2006
SCHOOL_GRADE_RANGE=Play Group to Class 10
SCHOOL_EMAIL=info@holychildschool.edu.bd
SCHOOL_PHONE=+880 1700-000000

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

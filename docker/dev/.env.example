# Host ports — what the stack publishes on this machine. Inside the compose
# network the services always use 80 and 5432; only these two change.
NGINX_HOST_PORT=8080
DB_HOST_PORT=5434
FRONTEND_HOST_PORT=5173
BACKEND_HOST_PORT=8000

# Core
DJANGO_ENV=development
DEBUG=True
# python -c "import secrets; print(secrets.token_urlsafe(50))"
# Avoid `$` in any value here — compose also reads this file for ${...} substitution.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,nginx

# Database — `db` is the service name on the compose network, not localhost.
# DATABASE_NAME / USER / PASSWORD also create the database on first start.
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=the_holy
DATABASE_USER=holy_user
DATABASE_PASSWORD=
DATABASE_HOST=db
DATABASE_PORT=5432

# JWT — blank signing key falls back to SECRET_KEY
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# CORS / CSRF — the site is served from http://localhost:8080 through nginx
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:8000

# Frontend — relative base path, nginx does the routing. Reached directly on
# :5173 instead, Vite proxies /api and /media to this target itself.
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://backend:8000

# Locale
TIME_ZONE=Asia/Dhaka
LANGUAGE_CODE=en-us
LOG_LEVEL=INFO

# Bootstrap administrator — seeded on every container start
DJANGO_ADMIN_EMAIL=admin@holychildschool.edu.bd
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_NAME=System Administrator

# School identity — seed values for a fresh database only. After the first
# run the profile lives in the database and is edited from Settings.
SCHOOL_NAME_EN=The Holy Child Pre-Cadet & High School
SCHOOL_NAME_BN=দি হলি চাইল্ড প্রি-ক্যাডেট এন্ড হাই স্কুল
SCHOOL_SHORT_NAME=Holy Child
SCHOOL_VILLAGE=Longorpara
SCHOOL_UPAZILA=Sribordi
SCHOOL_DISTRICT=Sherpur
SCHOOL_COUNTRY=Bangladesh
SCHOOL_ESTABLISHED=2006
SCHOOL_GRADE_RANGE=Play Group to Class 10
SCHOOL_EMAIL=info@holychildschool.edu.bd
SCHOOL_PHONE=+880 1700-000000
